+    extent:Object.freeze({widthM,heightM}), projection, local, sampleSurfaceAt,
+    groundElevationAt:(lat,lon)=>sampleSurfaceAt(lat,lon).groundElevationM,
+    toSnapshot:()=>copyJson(detail)});
+}
